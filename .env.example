# ── Sepolia deploy credentials (copy to .env and fill in) ──────────────────
# 1) Metamask → Account details → Show private key (0x + 64 hex chars)
PRIVATE_KEY=0x

# 2) Alchemy dashboard → Create App (Ethereum Sepolia) → HTTP endpoint
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/

# 3) etherscan.io/apis → Add → API key (same key works for Sepolia)
ETHERSCAN_API_KEY=

# Optional: local anvil RPC for smoke tests
ANVIL_RPC_URL=http://127.0.0.1:8545
